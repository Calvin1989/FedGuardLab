FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY requirements.txt requirements-cpu.txt ./

RUN python -m pip install --upgrade pip \
    && python -m pip install --timeout 120 --retries 5 -r requirements-cpu.txt

COPY api ./api
COPY fedguardlab ./fedguardlab
COPY configs ./configs
COPY compare_jobs.py .
COPY cleanup_reports.py .
COPY smoke_test.py .
COPY quick_test.py .

RUN mkdir -p reports/jobs reports/comparisons data

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

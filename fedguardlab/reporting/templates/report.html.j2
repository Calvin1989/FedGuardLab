{% set artifact_urls = artifact_urls|default({}) %}
{% set lang_code = lang|default("zh") %}
{% set L = labels|default({}) %}
<!DOCTYPE html>
<html lang="{{ lang_code }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ L.report_title|default("FedGuardLab 实验报告") }} - {{ job_id }}</title>
  <style>
    :root {
      color-scheme: light;
      --surface: rgba(255, 255, 255, 0.92);
      --surface-strong: #ffffff;
      --surface-soft: #f8fafc;
      --border: rgba(148, 163, 184, 0.24);
      --border-strong: rgba(148, 163, 184, 0.38);
      --text: #0f172a;
      --muted: #64748b;
      --muted-strong: #475569;
      --primary: #2563eb;
      --primary-strong: #1d4ed8;
      --primary-soft: #dbeafe;
      --success: #16a34a;
      --success-soft: #dcfce7;
      --shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
      --shadow-soft: 0 14px 40px rgba(15, 23, 42, 0.08);
      --radius-xl: 30px;
      --radius-lg: 20px;
      --radius-md: 14px;
    }

    * { box-sizing: border-box; }

    html {
      min-height: 100%;
      background:
        radial-gradient(circle at 12% 0%, rgba(99, 102, 241, 0.16), transparent 28%),
        radial-gradient(circle at 90% 8%, rgba(56, 189, 248, 0.18), transparent 30%),
        linear-gradient(135deg, #f6f7ff 0%, #f8fbff 48%, #f6f2ff 100%);
    }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 36px 20px 64px;
      color: var(--text);
      font-family:
        Inter, "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC",
        ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
    }

    .page-shell {
      max-width: 1120px;
      margin: 0 auto;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 42px 44px;
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      background:
        radial-gradient(circle at 96% 85%, rgba(59, 130, 246, 0.14), transparent 24%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(249, 251, 255, 0.9));
      box-shadow: var(--shadow);
    }

    .hero::before {
      content: "";
      position: absolute;
      right: -138px;
      bottom: -172px;
      width: 410px;
      height: 410px;
      border-radius: 999px;
      background: linear-gradient(135deg, rgba(96, 165, 250, 0.22), rgba(168, 85, 247, 0.09));
      pointer-events: none;
    }

    .hero::after {
      content: "";
      position: absolute;
      top: -150px;
      left: 38%;
      width: 330px;
      height: 330px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.62);
      filter: blur(16px);
      pointer-events: none;
    }

    .hero > * {
      position: relative;
      z-index: 1;
    }

    .top-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 30px;
      align-items: start;
    }

    .kicker {
      margin: 0 0 10px;
      color: var(--primary);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    h1 {
      max-width: 720px;
      margin: 0;
      color: var(--text);
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.08;
      letter-spacing: -0.052em;
    }

    .subtitle {
      max-width: 720px;
      margin: 18px 0 0;
      color: #5f6f87;
      font-size: 15px;
      line-height: 1.78;
    }

    .meta-panel,
    .meta-card {
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: rgba(255, 255, 255, 0.86);
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(14px);
    }

    .meta-panel strong,
    .meta-card span {
      display: block;
      color: var(--muted);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .meta-panel span,
    .meta-card strong {
      display: block;
      margin-top: 7px;
      overflow-wrap: anywhere;
      color: var(--text);
      font-weight: 900;
    }

    .meta-card strong {
      font-size: 28px;
      line-height: 1.1;
      letter-spacing: -0.04em;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
      min-width: 0;
    }

    .section {
      margin-top: 24px;
      padding: 26px;
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      background: var(--surface);
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(14px);
    }

    .section h2 {
      margin: 0 0 18px;
      color: var(--text);
      font-size: 23px;
      letter-spacing: -0.03em;
    }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-top: 24px;
    }

    .metric-card,
    .export-card {
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(248,250,252,0.92));
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    }

    .metric-label {
      display: block;
      color: var(--muted);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .metric-value {
      display: block;
      margin-top: 10px;
      color: var(--text);
      font-size: clamp(24px, 3vw, 34px);
      line-height: 1.1;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--surface-strong);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    th,
    td {
      padding: 13px 15px;
      border-bottom: 1px solid rgba(226, 232, 240, 0.9);
      vertical-align: top;
    }

    th {
      color: #334155;
      background: linear-gradient(180deg, #f8fafc, #f1f5f9);
      font-weight: 900;
      text-align: left;
      white-space: nowrap;
    }

    td {
      color: var(--muted-strong);
    }

    tr:last-child th,
    tr:last-child td {
      border-bottom: 0;
    }

    tbody tr:hover {
      background: rgba(37, 99, 235, 0.035);
    }

    .overview-table th {
      width: 34%;
    }

    .metrics-table th,
    .metrics-table td {
      text-align: right;
    }

    .metrics-table th:first-child,
    .metrics-table td:first-child {
      text-align: left;
    }

    .export-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .export-card strong {
      display: block;
      color: var(--text);
      font-size: 14px;
      font-weight: 900;
    }

    .export-card span {
      display: block;
      margin-top: 7px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }

    .config-details {
      margin-top: 18px;
      overflow: hidden;
      border: 1px solid rgba(15, 23, 42, 0.16);
      border-radius: var(--radius-lg);
      background: #0f172a;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
    }

    .config-details summary {
      cursor: pointer;
      padding: 16px 18px;
      color: #e2e8f0;
      font-weight: 900;
      background: rgba(15, 23, 42, 0.96);
    }

    pre {
      margin: 0;
      padding: 20px;
      overflow-x: auto;
      color: #dbeafe;
      background: #111827;
      font-size: 13px;
      line-height: 1.65;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    }

    .label-counts,
    .job-id {
      color: #334155;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 26px;
      padding: 5px 10px;
      border-radius: 999px;
      background: var(--primary-soft);
      color: var(--primary-strong);
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .status-badge::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: currentColor;
    }

    .metric-strong {
      color: var(--text);
      font-weight: 900;
    }

    .action-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 8px 13px;
      border: 1px solid rgba(147, 197, 253, 0.58);
      border-radius: 999px;
      color: var(--primary-strong);
      background: #eff6ff;
      font-size: 13px;
      font-weight: 900;
      text-decoration: none;
      white-space: nowrap;
      transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
    }

    .action-link:hover {
      transform: translateY(-1px);
      background: #dbeafe;
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.16);
    }

    .note {
      margin-top: 24px;
      padding: 18px 20px;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      color: var(--muted-strong);
      background: linear-gradient(180deg, rgba(255,255,255,0.92), rgba(248,250,252,0.88));
      line-height: 1.75;
    }

    code {
      padding: 2px 6px;
      border-radius: 7px;
      background: #e2e8f0;
      color: #334155;
      font-size: 12px;
    }

    @media (max-width: 900px) {
      body { padding: 24px 14px; }
      .top-row { grid-template-columns: 1fr; }
      .meta-panel { width: 100%; }
      .metric-grid,
      .export-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 640px) {
      .hero,
      .section { padding: 22px; border-radius: 22px; }
      .metric-grid,
      .export-grid { grid-template-columns: 1fr; }
      th,
      td { padding: 11px 12px; }
      h1 { font-size: clamp(30px, 10vw, 42px); }
    }


    /* v1.8.3 unified product report polish */
    :root {
      --surface: rgba(255, 255, 255, 0.94);
      --surface-strong: #ffffff;
      --border: rgba(148, 163, 184, 0.24);
      --text: #101828;
      --muted: #667085;
      --muted-strong: #475467;
      --primary: #1d4ed8;
      --primary-strong: #1d4ed8;
      --primary-soft: #eff6ff;
      --shadow: 0 18px 48px rgba(15, 23, 42, 0.07);
      --shadow-soft: 0 12px 32px rgba(15, 23, 42, 0.06);
      --radius-xl: 24px;
      --radius-lg: 16px;
      --radius-md: 10px;
    }

    html {
      background:
        radial-gradient(circle at 8% 0%, rgba(37, 99, 235, 0.08), transparent 28%),
        radial-gradient(circle at 92% 2%, rgba(14, 165, 233, 0.09), transparent 30%),
        linear-gradient(135deg, #f8fafc 0%, #f6f8fb 46%, #f7f5fb 100%);
    }

    body {
      padding: 28px 20px 56px;
      font-size: 14px;
    }

    .page-shell {
      max-width: 1120px;
    }

    .hero,
    .section {
      border-color: var(--border);
      background: var(--surface);
      box-shadow: var(--shadow);
      backdrop-filter: none;
    }

    .hero {
      padding: 30px 34px;
    }

    .hero::before {
      right: -170px;
      bottom: -210px;
      width: 360px;
      height: 360px;
      opacity: 0.65;
    }

    .hero::after {
      display: none;
    }

    .top-row {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
      gap: 24px;
      align-items: start;
    }

    .kicker {
      margin-bottom: 8px;
      font-size: 11px;
      letter-spacing: 0.15em;
    }

    h1 {
      font-size: clamp(32px, 3.4vw, 46px);
      letter-spacing: -0.045em;
    }

    .subtitle {
      margin-top: 10px;
      font-size: 14px;
      line-height: 1.62;
    }

    .meta-panel,
    .meta-card,
    .metric-card,
    .export-card {
      border-color: var(--border);
      background: #ffffff;
      box-shadow: none;
      backdrop-filter: none;
    }

    .meta-panel {
      padding: 16px;
    }

    .meta-panel span,
    .meta-card strong {
      font-size: 13px;
      line-height: 1.45;
    }

    .metric-grid {
      gap: 12px;
      margin-top: 20px;
    }

    .metric-card {
      padding: 16px;
      border-radius: 16px;
    }

    .metric-label {
      font-size: 11px;
      letter-spacing: 0.04em;
    }

    .metric-value {
      margin-top: 8px;
      font-size: clamp(22px, 2.4vw, 28px);
    }

    .section {
      margin-top: 18px;
      padding: 24px;
    }

    .section h2 {
      margin-bottom: 14px;
      font-size: 21px;
    }

    .table-wrap {
      border-radius: 16px;
      background: #ffffff;
    }

    table {
      font-size: 13px;
    }

    th,
    td {
      padding: 12px 14px;
    }

    th {
      background: #f8fafc;
    }

    .metrics-table th,
    .metrics-table td {
      text-align: right;
    }

    .metrics-table th:first-child,
    .metrics-table td:first-child {
      text-align: left;
    }

    .label-counts {
      max-width: 680px;
      color: #334155;
      font-size: 11px;
      line-height: 1.65;
      white-space: normal;
    }

    .export-grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    .export-card {
      padding: 14px 16px;
      border-radius: 14px;
      text-decoration: none;
    }

    .export-card:hover {
      border-color: rgba(37, 99, 235, 0.35);
      background: #f8fbff;
    }

    .config-details {
      margin-top: 16px;
      border-color: rgba(148, 163, 184, 0.28);
      border-radius: 16px;
      background: #0f172a;
      box-shadow: none;
    }

    .config-details summary {
      padding: 13px 16px;
      background: #111827;
      color: #f8fafc;
      font-size: 13px;
    }

    pre {
      max-height: 460px;
      padding: 16px;
      font-size: 12px;
      line-height: 1.58;
    }

    .action-link {
      border-radius: 10px;
      box-shadow: none;
    }

    @media (max-width: 900px) {
      body { padding: 22px 14px 44px; }
      .top-row { grid-template-columns: 1fr; }
      .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 640px) {
      .hero,
      .section { padding: 20px; border-radius: 20px; }
      .metric-grid,
      .export-grid { grid-template-columns: 1fr; }
      h1 { font-size: clamp(30px, 10vw, 40px); }
    }


    /* v1.8.4 final report polish: typography and subtle motion */
    html {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    body {
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "PingFang SC",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        sans-serif;
      font-variant-numeric: tabular-nums;
    }

    .kicker {
      font-weight: 800;
      letter-spacing: 0.12em;
    }

    h1 {
      font-weight: 800;
      letter-spacing: -0.032em;
      line-height: 1.08;
    }

    .section h2 {
      font-weight: 800;
      letter-spacing: -0.018em;
    }

    .subtitle,
    .note,
    .export-card span,
    .label-counts,
    td,
    th {
      line-height: 1.62;
    }

    .meta-card span,
    .metric-label,
    .export-card span {
      font-weight: 800;
      line-height: 1.35;
    }

    .metric-value,
    .meta-card strong,
    .job-id,
    code,
    pre {
      font-variant-numeric: tabular-nums;
    }

    .hero,
    .section {
      animation: reportFadeIn 0.28s ease-out both;
    }

    .export-card,
    .action-link {
      transition:
        transform 0.16s ease,
        border-color 0.16s ease,
        background-color 0.16s ease,
        box-shadow 0.16s ease;
    }

    .export-card:hover,
    .action-link:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.10);
    }

    @keyframes reportFadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }

  </style>
</head>
<body>
  <main class="page-shell">
    <section class="hero">
      <div class="top-row">
        <div>
          <p class="kicker">{{ L.report_kicker|default("FedGuardLab Experiment Report") }}</p>
          <h1>{{ L.report_title|default("FedGuardLab 实验报告") }}</h1>
          <p class="subtitle">
            {{ L.report_subtitle|default("查看本次联邦学习安全实验的最终指标、配置摘要、导出文件与逐轮训练结果。") }}
          </p>
        </div>

        <aside class="meta-panel">
          <strong>{{ L.job_id|default("任务 ID") }}</strong>
          <span>{{ job_id }}</span>
          <br />
          <strong>{{ L.status|default("状态") }}</strong>
          <span class="status-badge">{{ status }}</span>
        </aside>
      </div>

      <div class="metric-grid">
        <div class="metric-card">
          <span class="metric-label">{{ L.final_round|default("最终轮次") }}</span>
          <strong class="metric-value">{{ final_metric.round }}</strong>
        </div>

        <div class="metric-card">
          <span class="metric-label">{{ L.final_accuracy|default("最终准确率") }}</span>
          <strong class="metric-value">{{ final_metric.accuracy }}</strong>
        </div>

        <div class="metric-card">
          <span class="metric-label">{{ L.final_loss|default("最终损失") }}</span>
          <strong class="metric-value">{{ final_metric.loss }}</strong>
        </div>

        <div class="metric-card">
          <span class="metric-label">{{ L.final_asr|default("最终 ASR") }}</span>
          <strong class="metric-value">{{ final_metric.attack_success_rate }}</strong>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>{{ L.experiment_overview|default("实验概览") }}</h2>

      <div class="table-wrap">
        <table class="overview-table">
          <tbody>
            <tr>
              <th>{{ L.trainer|default("训练器") }}</th>
              <td>{{ final_metric.trainer }}</td>
            </tr>
            <tr>
              <th>{{ L.mode|default("模式") }}</th>
              <td>{{ final_metric.mode }}</td>
            </tr>
            <tr>
              <th>{{ L.dataset|default("数据集") }}</th>
              <td>{{ final_metric.dataset }}</td>
            </tr>
            <tr>
              <th>{{ L.partition|default("数据划分") }}</th>
              <td>{{ final_metric.partition }}</td>
            </tr>
            <tr>
              <th>{{ L.clients|default("客户端数量") }}</th>
              <td>{{ final_metric.num_clients }}</td>
            </tr>
            <tr>
              <th>{{ L.malicious_clients|default("恶意客户端") }}</th>
              <td>{{ final_metric.malicious_clients }}</td>
            </tr>
            <tr>
              <th>{{ L.aggregation|default("聚合方法") }}</th>
              <td>{{ final_metric.aggregation }}</td>
            </tr>
            <tr>
              <th>{{ L.attack|default("攻击") }}</th>
              <td>{{ final_metric.attack }}</td>
            </tr>
            <tr>
              <th>{{ L.defense|default("防御") }}</th>
              <td>{{ final_metric.defense }}</td>
            </tr>
            <tr>
              <th>{{ L.device|default("设备") }}</th>
              <td>{{ final_metric.device }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    {% if final_metric.client_label_summary is defined %}
    <section class="section">
      <h2>{{ L.client_label_distribution|default("客户端标签分布") }}</h2>

      <div class="table-wrap">
        <table class="metrics-table">
          <thead>
            <tr>
              <th>{{ L.client_id|default("客户端 ID") }}</th>
              <th>{{ L.samples|default("样本数") }}</th>
              <th>{{ L.label_counts|default("标签计数") }}</th>
            </tr>
          </thead>
          <tbody>
            {% for client in final_metric.client_label_summary %}
            <tr>
              <td>{{ client.client_id }}</td>
              <td>{{ client.num_samples }}</td>
              <td class="label-counts">{{ client.label_counts }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    <section class="section">
      <h2>{{ L.exported_files|default("导出文件") }}</h2>

      <div class="export-grid">
        <a
          class="export-card export-download"
          href="{{ artifact_urls.config_json_url|default('#config-details-section') }}"
          download
        >
          <strong>config.json</strong>
          <span>{{ L.export_config|default("实验配置") }}</span>
        </a>

        <a
          class="export-card export-download"
          href="{{ artifact_urls.metrics_json_url|default('#') }}"
          download
        >
          <strong>metrics.json</strong>
          <span>{{ L.export_metrics_json|default("逐轮原始指标") }}</span>
        </a>

        <a
          class="export-card export-download"
          href="{{ artifact_urls.metrics_csv_url|default('#') }}"
          download
        >
          <strong>metrics.csv</strong>
          <span>{{ L.export_metrics_csv|default("可导入表格的指标") }}</span>
        </a>

        <a
          class="export-card export-download"
          href="{{ artifact_urls.summary_md_url|default('#') }}"
          download
        >
          <strong>report.md</strong>
          <span>{{ L.export_report_md|default("Markdown 实验摘要") }}</span>
        </a>
      </div>

      <details class="config-details" id="config-details-section">
        <summary>{{ L.config_details|default("实验配置详情") }}</summary>
        <pre>{{ config_json }}</pre>
      </details>
    </section>

    <section class="section">
      <h2>{{ L.metrics|default("指标") }}</h2>

      <div class="table-wrap">
        <table class="metrics-table">
          <thead>
            <tr>
              <th>{{ L.round|default("轮次") }}</th>
              <th>{{ L.accuracy|default("准确率") }}</th>
              <th>{{ L.loss|default("损失") }}</th>
              <th>{{ L.attack_success_rate|default("攻击成功率") }}</th>
            </tr>
          </thead>
          <tbody>
            {% for item in metrics %}
            <tr>
              <td>{{ item.round }}</td>
              <td>{{ item.accuracy }}</td>
              <td>{{ item.loss }}</td>
              <td>{{ item.attack_success_rate }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>

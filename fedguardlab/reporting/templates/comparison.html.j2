<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ labels.title }} - {{ comparison_id }}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
      background: #f8fafc;
      color: #0f172a;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      background: white;
      padding: 32px;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }

    h1, h2 {
      margin-top: 0;
    }

    .muted {
      color: #64748b;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
    }

    th, td {
      border-bottom: 1px solid #e2e8f0;
      padding: 10px;
      text-align: left;
      vertical-align: top;
    }

    th {
      background: #f1f5f9;
    }

    a {
      color: #2563eb;
      font-weight: 700;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .highlight {
      font-weight: 700;
    }

    .note {
      margin-top: 24px;
      padding: 16px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      color: #475569;
    }
  </style>
</head>
<body>
  <div class="container">
    <p class="muted">{{ labels.title }}</p>
    <h1>{{ title }}</h1>

    <p><strong>{{ labels.comparison_id }}：</strong> {{ comparison_id }}</p>
    <p><strong>{{ labels.num_experiments }}：</strong> {{ experiments | length }}</p>

    <h2>{{ labels.final_metrics }}</h2>

    <table>
      <thead>
        <tr>
          <th>{{ labels.experiment }}</th>
          <th>{{ labels.aggregation }}</th>
          <th>{{ labels.defense }}</th>
          <th>{{ labels.attack }}</th>
          <th>{{ labels.final_accuracy }}</th>
          <th>{{ labels.final_loss }}</th>
          <th>{{ labels.final_asr }}</th>
          <th>{{ labels.job_id }}</th>
          <th>{{ labels.report }}</th>
        </tr>
      </thead>
      <tbody>
        {% for item in experiments %}
        <tr>
          <td>{{ item.experiment_name }}</td>
          <td>{{ item.aggregation }}</td>
          <td>{{ item.defense }}</td>
          <td>{{ item.attack }}</td>
          <td>{{ item.final_accuracy }}</td>
          <td>{{ item.final_loss }}</td>
          <td class="highlight">{{ item.final_asr }}</td>
          <td>{{ item.job_id }}</td>
          <td>
            <a href="{{ api_base_url }}/reports/{{ item.job_id }}?lang={{ lang }}" target="_blank">
              {{ labels.open }}
            </a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="note">
      {{ labels.note }}
      <p>
        {{ labels.exported_files }}：<code>comparison.json</code> {{ labels.and }} <code>comparison.csv</code>
      </p>
    </div>
  </div>
</body>
</html>
